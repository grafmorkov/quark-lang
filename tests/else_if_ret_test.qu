load "std::io";
using std::io;

i32 classify(i32 value) {
    if (value > 10) {
        return 1;
    } else if (value > 5) {
        return 2;
    } else {
        return 3;
    }
}

i32 main() {
    println(classify(20) as str);
    println(classify(7) as str);
    println(classify(1) as str);
    return 0;
}
