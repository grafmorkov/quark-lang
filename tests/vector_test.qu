load "std::io";
load "std::vector";

using std::vector;

void main() {
    @init mut Vec<i32> v;

    v.push(10);
    v.push(20);
    v.push(30);

    std::io::print("len: ");
    std::io::print(v.len() as str);
    std::io::print("\n");

    std::io::print("get[0]: ");
    std::io::print(v.get(0) as str);
    std::io::print("\n");

    std::io::print("get[1]: ");
    std::io::print(v.get(1) as str);
    std::io::print("\n");

    std::io::print("get[2]: ");
    std::io::print(v.get(2) as str);
    std::io::print("\n");

    v.free();
}
