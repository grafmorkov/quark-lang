load "std::io";
using std::io;

// Regression test: every `as str` result must point to its own buffer.
// Before the fix all results aliased one shared scratch buffer, so this
// printed the last formatted value repeatedly instead of the true ones.

i32 pick(i32 value) {
    mut i32 result = 0;
    if (value > 10) {
        result = 1;
    } else {
        result = 4;
    }
    return result;
}

i32 main() {
    i32 x = 20;
    str s1 = x as str;
    str s2 = 20 as str;
    str s3 = 2 as str;
    println(s1);
    println(s2);
    println(s3);

    str a = pick(20) as str;
    str b = pick(1) as str;
    println(a);
    println(b);
    return 0;
}
