load "std::io";
using std::io;

i32 main() {
    mut i32 result = 0;
    i32 value = 7;

    if (value > 10) {
        result = 1;
    } else if (value > 5) {
        result = 2;
    } else if (value > 0) {
        result = 3;
    } else {
        result = 4;
    }
    str msg = result as str;
    println(msg);

    // without trailing else
    mut i32 count = 0;
    if (value > 10) {
        count = 1;
    } else if (value > 5) {
        count = 2;
    }
    str msg2 = count as str;
    println(msg2);

    return 0;
}
