load "std::io";
using std::io;

str classify(i32 n) {
    mut str s = "x";
    if (n < 2) {
        s = "small";
    } else if (n < 5) {
        s = "medium";
    } else {
        s = "large";
    }
    return s;
}

i32 main() {
    str a = 1 as str;
    str b = 2 as str;
    str c = 3 as str;
    println(a);
    println(b);
    println(c);
    println(classify(1));
    println(classify(3));
    println(classify(9));
    println(12345 as str);
    println((-42) as str);
    println(0 as str);
    return 0;
}
