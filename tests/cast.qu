    i32 main() {
        // value cast - widening signed
        i8 a = 42 as i8;
        i64 b = a as i64;

        // value cast - narrowing
        i64 c = 1000 as i64;
        i8 d = c as i8;

        // value cast - same size signedness change
        i32 e = 100 as i32;
        u32 f = e as u32;

        // bitcast - integer to integer same size
        i32 g = 200 as i32;
        u32 h = g as! u32;

        return 0 as i32;
    }
