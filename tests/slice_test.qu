load "std::io";
load "std::types";
using std::types;

void main() {
    region r {
        *i32 buf = alloc(i32, 10);
        slice<i32> s = slice_make<i32>(buf, 10);

        // len / is_empty
        u64 l = s.len();

        if (l != (10 as u64)) { std::io::print("BAD len\n"); return; }
        if (s.is_empty()) { std::io::print("BAD empty\n"); return; }

        slice<i32> e = slice_empty<i32>();

        if (!e.is_empty()) { std::io::print("BAD empty2\n"); return; }

        // set / get
        s.set(0, 42);
        s.set(1, 100);
        s.set(2, 7);
        s.set(9, 7);

        i32 g0 = s.get(0);
        if (g0 != (42 as i32)) { std::io::print("BAD get0\n"); return; }

        i32 g1 = s.get(1);
        if (g1 != (100 as i32)) { std::io::print("BAD get1\n"); return; }

        i32 g9 = s.get(9);
        if (g9 != (7 as i32)) { std::io::print("BAD get9\n"); return; }

        // in_bounds
        if (!s.in_bounds(0)) { std::io::print("BAD ib\n"); return; }
        if (!s.in_bounds(9)) { std::io::print("BAD ib9\n"); return; }
        if (s.in_bounds(10)) { std::io::print("BAD ib10\n"); return; }

        // at (bounds-checked, returns option<T>)
        option<i32> a = s.at(1);
        if (!a.is_some()) { std::io::print("BAD at1\n"); return; }
        if (a.unwrap() != (100 as i32)) { std::io::print("BAD at1v\n"); return; }
        option<i32> b = s.at(20);
        if (!b.is_none()) { std::io::print("BAD at20\n"); return; }

        // ptr
        *i32 p = s.ptr();
        if (p != buf) { std::io::print("BAD ptr\n"); return; }

        // sub (view)
        slice<i32> sub = s.sub(1, 3);
        if (sub.len() != (3 as u64)) { std::io::print("BAD sub len\n"); return; }
        i32 sg = sub.get(0);
        if (sg != (100 as i32)) { std::io::print("BAD sub0\n"); return; }

        // sub clamping / out-of-range
        slice<i32> sc = s.sub(8, 100);
        if (sc.len() != (2 as u64)) { std::io::print("BAD sub clamp\n"); return; }

        slice<i32> so = s.sub(50, 3);
        if (!so.is_empty()) { std::io::print("BAD sub oob\n"); return; }

        // copy_from
        *i32 buf2 = alloc(i32, 4);
        slice<i32> dst = slice_make<i32>(buf2, 4);
        dst.copy_from(&sub);
        if (dst.len() != (4 as u64)) { std::io::print("BAD copy len\n"); return; }

        i32 cg = dst.get(0);
        if (cg != (100 as i32)) { std::io::print("BAD copy0\n"); return; }

        i32 cg1 = dst.get(1);
        if (cg1 != (7 as i32)) { std::io::print("BAD copy1\n"); return; }

        std::io::print("slice OK\n");
    }
}
