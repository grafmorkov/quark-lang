i32 main() {
    // int -> int widening (signed)
    i8 a = 42 as i8;
    i16 b = a as i16;
    i32 c = b as i32;
    i64 d = c as i64;

    // int -> int widening (unsigned)
    u8 e = 42 as u8;
    u16 f = e as u16;
    u32 g = f as u32;
    u64 h = g as u64;

    // int -> int narrowing
    i64 i = 1000 as i64;
    i32 j = i as i32;
    i16 k = j as i16;
    i8 l = k as i8;

    // same-size signedness change
    i32 m = 100 as i32;
    u32 n = m as u32;

    // bitcast same size
    i64 o = 500 as i64;
    u64 p = o as! u64;

    // string casts
    str q = 42 as str;
    str r = 0 as str;
    str s = 255 as u32 as str;
    str t = 1000 as i64 as str;

    return 0 as i32;
}
