load "std::io";
using std::io;

func main() i32 {
    mut result: i32 = 0;
    value: i32 = 7;

    if (value > 10) {
        result = 1;
    } else if (value > 5) {
        result = 2;
    } else if (value > 0) {
        result = 3;
    } else {
        result = 4;
    }
    msg: str = result as str;
    println(msg);

    // without trailing else
    mut count: i32 = 0;
    if (value > 10) {
        count = 1;
    } else if (value > 5) {
        count = 2;
    }
    msg2: str = count as str;
    println(msg2);

    return 0;
}
