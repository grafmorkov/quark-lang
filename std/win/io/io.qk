// std::io - Windows implementation for the native (PE) backend.
//
// Uses @import (WinAPI) instead of Linux syscalls.
// str is a null-terminated char pointer (LPCSTR), so it maps
// directly onto the WinAPI buffer parameters.
//
// Usage:
//   load "std::io";
//
//   func main() {
//       std::io::print("hello ");
//       std::io::println("world");
//       std::io::print_char(65 as i8);  // prints 'A'
//       std::io::exit(0);
//   }

module "std::io";

@import("kernel32.dll", "GetStdHandle") extern func sys_get_std_handle(nStdHandle: i64) i64;
@import("kernel32.dll", "WriteFile") extern func sys_write_file(hFile: i64, lpBuffer: str, nNumberOfBytesToWrite: i64, lpNumberOfBytesWritten: str, lpOverlapped: *void) i32;
@import("kernel32.dll", "ReadFile") extern func sys_read_file(hFile: i64, lpBuffer: str, nNumberOfBytesToRead: i64, lpNumberOfBytesRead: str, lpOverlapped: *void) i32;
@import("kernel32.dll", "ExitProcess") extern func sys_exit_process(uExitCode: u32) void;
@import("kernel32.dll", "CreateFileA") extern func sys_create_file(lpFileName: str, dwDesiredAccess: u32, dwShareMode: u32, lpSecurityAttributes: *void, dwCreationDisposition: u32, dwFlagsAndAttributes: u32, hTemplateFile: *void) i64;
@import("kernel32.dll", "CloseHandle") extern func sys_close_handle(hObject: i64) i32;
@import("kernel32.dll", "SetFilePointerEx") extern func sys_set_file_pointer(hFile: i64, liDistanceToMove: i64, lpNewFilePointer: *void, dwMoveMethod: u32) i32;
@import("kernel32.dll", "FlushFileBuffers") extern func sys_flush_file_buffers(hFile: i64) i32;

@init mut g_stdout: i64;
@init mut g_stdin: i64;
@init mut g_stderr: i64;

// Scratch location for the WinAPI "bytes transferred" out-parameter.
// The Quark `&` operator only works on non-scalars, so it's a struct.
struct IoScratch { v: i64; };
@init mut g_scratch: IoScratch;

// qk_io_init - cache the standard handles. Called by the generated entry stub.
@export("qk_io_init") func qk_io_init() void {
    g_stdout = sys_get_std_handle(-11);
    g_stdin = sys_get_std_handle(-10);
    g_stderr = sys_get_std_handle(-12);
}

// strlen - get string length (without \0).
func strlen(s: str) i64 {
    p: *i8 = s as! *i8;
    mut i: i32 = 0;
    while (true) {
        c: i8 = p[i];
        if (c == (0 as i8)) { return i as i64; }
        i = i + 1;
    }
    return 0;
}

// print - print string to stdout.
func print(text: str) void {
    sys_write_file(g_stdout, text, strlen(text), (&g_scratch) as! str, 0 as! *void);
}

// println - print string + newline to stdout.
func println(text: str) void {
    print(text);
    print_char(10);
}

// eprint - print string to stderr.
func eprint(text: str) void {
    sys_write_file(g_stderr, text, strlen(text), (&g_scratch) as! str, 0 as! *void);
}

// print_char - print one byte to stdout.
struct PutcBuf { c: i8; };
@init mut g_putc_buf: PutcBuf;

func print_char(c: i8) void {
    g_putc_buf.c = c;
    sys_write_file(g_stdout, (&g_putc_buf) as! str, 1, (&g_scratch) as! str, 0 as! *void);
}

// exit - exit program with the given code.
func exit(code: i32) void {
    sys_exit_process(code as u32);
}

// write - write bytes to a handle. Returns bytes written.
func write(fd: i64, buf: str, len: i64) i64 {
    sys_write_file(fd, buf, len, (&g_scratch) as! str, 0 as! *void);
    return g_scratch.v;
}

// read_fd - read bytes from a handle. Returns bytes read.
func read_fd(fd: i64, buf: str, len: i64) i64 {
    sys_read_file(fd, buf, len, (&g_scratch) as! str, 0 as! *void);
    return g_scratch.v;
}

// read - read from stdin. Returns bytes read.
func read(buf: str, len: i64) i64 {
    sys_read_file(g_stdin, buf, len, (&g_scratch) as! str, 0 as! *void);
    return g_scratch.v;
}

// read_char - read one byte from stdin.
func read_char() i64 {
    sys_read_file(g_stdin, (&g_putc_buf) as! str, 1, (&g_scratch) as! str, 0 as! *void);
    if (g_scratch.v <= (0 as i64)) { return -1; }
    return g_putc_buf.c as i64;
}

struct FpScratch { v: i64; };
@init mut g_fp: FpScratch;

// open - open/create a file. flags = dwDesiredAccess (e.g. GENERIC_WRITE = 0x40000000),
// mode = dwCreationDisposition (e.g. CREATE_ALWAYS = 2). Returns a handle, or < 0 on failure.
func open(path: str, flags: i32, mode: i32) i64 {
    return sys_create_file(path, flags as u32, 0, 0 as! *void, mode as u32, (128 as u32), 0 as! *void);
}

// close - close a file handle.
func close(fd: i64) i64 {
    if (sys_close_handle(fd) == 0) { return -1; }
    return 0;
}

// seek - seek within a file. whence: 0 = BEGIN, 1 = CURRENT, 2 = END.
func seek(fd: i64, offset: i64, whence: i32) i64 {
    r: i32 = sys_set_file_pointer(fd, offset, (&g_fp) as! *void, whence as u32);
    if (r == 0) { return -1; }
    return g_fp.v;
}

// flush - flush file buffers to disk.
func flush(fd: i64) i64 {
    if (sys_flush_file_buffers(fd) == 0) { return -1; }
    return 0;
}
