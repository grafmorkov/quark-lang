// std::heap - Windows implementation for the native (PE) backend.
//
// Same allocator as the Linux version, but backed by VirtualAlloc
// (kernel32.dll) instead of mmap.

module "std::heap";

@import("kernel32.dll", "VirtualAlloc") extern *void sys_virtual_alloc(*void lpAddress, u64 dwSize, u32 flAllocationType, u32 flProtect);

@init mut u64 heap_head;

// clear_alloc_bit - clear the "allocated" flag (bit 0) of a block header.
u64 clear_alloc_bit(u64 size_flags) {
    return size_flags & ((-2 as i64) as u64);
}

// align16 - round `size` up to a 16-byte boundary, minimum 32 bytes.
u64 align16(u64 size) {
    mut u64 a = size + 31;
    a = a & ((-16 as i64) as u64);
    if (a < 32) { return 32; }
    return a;
}

// unlink_free - remove `target` from the free list.
// Returns the block itself on success, or 0 if it wasn't in the list.
u64 unlink_free(u64 target) {
    mut u64 cur = heap_head;
    mut u64 prev = 0;
    while (cur != 0) {
        if (cur == target) {
            u64 next = (cur as! *u64)[1];
            if (prev == 0) {
                heap_head = next;
            } else {
                (prev as! *u64)[1] = next;
            }
            return cur;
        }
        prev = cur;
        cur = (cur as! *u64)[1];
    }
    return 0;
}

// alloc_from_list - satisfy an allocation from the existing free list.
// Returns NULL if no free block is big enough.
*void alloc_from_list(u64 need) {
    mut u64 cur = heap_head;
    mut u64 prev = 0;
    while (cur != 0) {
        mut u64 size = clear_alloc_bit((cur as! *u64)[0]);
        if (size >= need) {
            u64 rest = size - need;
            if (rest < 32) {
                // Exact fit: mark as allocated and unlink.
                (cur as! *u64)[0] = size | 1;
                u64 next = (cur as! *u64)[1];
                if (prev == 0) {
                    heap_head = next;
                } else {
                    (prev as! *u64)[1] = next;
                }
                return (cur + 16) as! *void;
            }
            // Split from the end: keep `rest` as a free block, take the top.
            (cur as! *u64)[0] = rest;
            u64 used = cur + rest;
            (used as! *u64)[0] = need | 1;
            return (used + 16) as! *void;
        }
        prev = cur;
        cur = (cur as! *u64)[1];
    }
    return 0 as! *void;
}

// refill - allocate a new chunk and add it to the free list as one free block.
bool refill() {
    u64 chunk = sys_virtual_alloc(0 as! *void, 65536, 12288, 4) as! u64;
    if (chunk == 0) { return false; }
    u64 size = (65536 as u64) - 64;
    (chunk as! *u64)[0] = size;
    (chunk as! *u64)[1] = heap_head;
    heap_head = chunk;
    u64 guard = chunk + size;
    (guard as! *u64)[0] = 1;
    return true;
}

// heap_malloc - allocate `size` bytes. Returns a 16-byte aligned pointer, or NULL.
*void heap_malloc(u64 size) {
    u64 need = align16(size);
    for (;;) {
        *void p = alloc_from_list(need);
        if (p != (0 as! *void)) { return p; }
        if (!refill()) { return 0 as! *void; }
    }
    return 0 as! *void;
}

// heap_free - free a pointer previously returned by heap_malloc/realloc.
// free(NULL) is a no-op.
void heap_free(*void ptr) {
    if (ptr == (0 as! *void)) { return; }
    u64 blk = (ptr as! u64) - 16;

    // Mark as free and try to coalesce with the next physical block.
    mut u64 size = clear_alloc_bit((blk as! *u64)[0]);
    (blk as! *u64)[0] = size;

    u64 next = blk + size;
    u64 next_flags = (next as! *u64)[0];
    if ((next_flags & 1) == 0) {
        if (unlink_free(next) != 0) {
            u64 next_size = clear_alloc_bit(next_flags);
            (blk as! *u64)[0] = size + next_size;
        }
    }

    // Insert the block at the head of the free list.
    (blk as! *u64)[1] = heap_head;
    heap_head = blk;
}

// heap_realloc - resize an allocation; may move the data.
// Returns the new pointer, or NULL on OOM.
*void heap_realloc(*void ptr, u64 new_size) {
    if (ptr == (0 as! *void)) { return heap_malloc(new_size); }
    if (new_size == 0) {
        heap_free(ptr);
        return 0 as! *void;
    }

    u64 old = ptr as! u64;
    u64 blk = old - 16;
    mut u64 old_size = clear_alloc_bit((blk as! *u64)[0]);
    u64 need = align16(new_size);

    // The new size fits in the old block - done (maybe shrink).
    if (need <= old_size) {
        u64 rest = old_size - need;
        if (rest >= 32) {
            u64 nb = blk + need;
            (blk as! *u64)[0] = need | 1;
            (nb as! *u64)[0] = rest;
            heap_free((nb + 16) as! *void);
        }
        return ptr;
    }

    // Try to extend into the next physical block if it is free.
    u64 next = blk + old_size;
    u64 next_flags = (next as! *u64)[0];
    if ((next_flags & 1) == 0) {
        u64 next_size = clear_alloc_bit(next_flags);
        if ((old_size + next_size) >= need) {
            if (unlink_free(next) != 0) {
                // Merge and mark as used, then shrink if larger than needed.
                (blk as! *u64)[0] = (old_size + next_size) | 1;
                u64 rest = (old_size + next_size) - need;
                if (rest >= 32) {
                    u64 nb = blk + need;
                    (blk as! *u64)[0] = need | 1;
                    (nb as! *u64)[0] = rest;
                    heap_free((nb + 16) as! *void);
                }
            }
        }
        return ptr;
    }

    // Allocate a new block and move the data.
    *void nptr = heap_malloc(new_size);
    if (nptr == (0 as! *void)) { return 0 as! *void; }

    u64 old_usable = old_size - 16;
    u64 new_usable = need - 16;
    mut u64 len = old_usable;
    if (new_usable < len) { len = new_usable; }

    u64 dst = nptr as! u64;
    for (mut u64 i = 0; i < len; i++) {
        ((dst + i) as! *u8)[0] = ((old + i) as! *u8)[0];
    }

    heap_free(ptr);
    return nptr;
}
