// std::arena - Windows implementation for the native (PE) backend.
//
// Region (bump pointer) allocator built on VirtualAlloc/VirtualFree
// (kernel32.dll) instead of mmap/munmap.

module "std::arena";

@import("kernel32.dll", "VirtualAlloc") extern func sys_virtual_alloc(lpAddress: *void, dwSize: u64, flAllocationType: u32, flProtect: u32) *void;
@import("kernel32.dll", "VirtualFree") extern func sys_virtual_free(lpAddress: *void, dwSize: u64, dwFreeType: u32) i32;

struct Region {
    data: *void;
    offset: u64;
    capacity: u64;
};

@init mut g_global_region: Region;

// _region_mmap - map `size` bytes of readable/writable memory.
func _region_mmap(size: u64) *void {
    return sys_virtual_alloc(0 as! *void, size, (12288 as u32), (4 as u32));
}

// _region_munmap - release `size` bytes previously returned by _region_mmap.
func _region_munmap(ptr: *void, size: u64) void {
    if (ptr == (0 as! *void)) { return; }
    sys_virtual_free(ptr, 0 as u64, (32768 as u32));
}

// _region_bump - allocate `size` bytes from a region (16-byte aligned).
// Returns NULL if the region has no space left.
func _region_bump(mut reg: &Region, size: u64) *void {
    mut a: u64 = size + (15 as u64);
    a = a & ((-16 as i64) as u64);
    off: u64 = reg.offset;
    end: u64 = off + a;
    if (end > reg.capacity) { return 0 as! *void; }
    res: u64 = (reg.data as! u64) + off;
    reg.offset = end;
    return res as! *void;
}

// _create - create a new region backed by an allocated block of `size` bytes.
func _create(size: u64) Region {
    mut r: Region;
    r.data = _region_mmap(size);
    r.offset = 0;
    r.capacity = size;
    return r;
}

// _destroy - release the backing memory of a region.
func _destroy(mut reg: &Region) void {
    _region_munmap(reg.data, reg.capacity);
    reg.data = 0 as! *void;
    reg.offset = 0;
    reg.capacity = 0;
}

// _global_region - returns the process-wide region used by std::string.
func _global_region() &Region {
    return &g_global_region;
}

// _init_global_region - (re)allocate the global region backing memory.
func _init_global_region(size: u64) void {
    if (g_global_region.data != (0 as! *void)) {
        _region_munmap(g_global_region.data, g_global_region.capacity);
        g_global_region.data = 0 as! *void;
    }
    g_global_region.data = _region_mmap(size);
    g_global_region.offset = 0;
    g_global_region.capacity = size;
}
