// std::math
//
// Math functions. Most are generic and work with any numeric type
// (i32, i64, u32, u64, f64).
//
// Usage:
//   load "std::math";
//
//   i32 main() {
//       a: i32 = min<i32>(3, 7);       // 3
//       b: i32 = max<i32>(3, 7);       // 7
//       c: i32 = clamp<i32>(15, 0, 10); // 10
//       d: i32 = abs_i32(-42);         // 42
//       return 0;
//   }

module "std::math";

// min<T> - return the smaller of two values.
T min<T>(T a, T b) {
    if (a < b) { return a; } else { return b; }
}

// max<T> - return the larger of two values.
T max<T>(T a, T b) {
    if (a > b) { return a; } else { return b; }
}

// abs_i32 - absolute value for i32.
i32 abs_i32(i32 x) {
    if (x < 0) { return -x; } else { return x; }
}

// abs_i64 - absolute value for i64.
i64 abs_i64(i64 x) {
    if (x < (0 as i64)) { return -x; } else { return x; }
}

// abs_f64 - absolute value for f64.
f64 abs_f64(f64 x) {
    if (x < 0.0) { return -x; } else { return x; }
}

// clamp<T> - limit value to range [lo, hi].
T clamp<T>(T x, T lo, T hi) {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

// sum<T> - add two values.
T sum<T>(T a, T b) {
    return a + b;
}

// diff<T> - subtract b from a.
T diff<T>(T a, T b) {
    return a - b;
}

// prod<T> - multiply two values.
T prod<T>(T a, T b) {
    return a * b;
}

// div<T> - divide a by b.
T div<T>(T a, T b) {
    return a / b;
}
