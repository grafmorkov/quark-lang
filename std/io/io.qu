// std::io
//
// Input/output functions. Pure Quanta implementation using inline syscalls.
//
// Usage:
//   load "std::io";
//
//   func main() i32 {
//       std::io::print("hello ");
//       std::io::println("world");
//       std::io::print_char(65 as i8);  // prints 'A'
//
//       fd: i64 = std::io::open("test.txt", 65, 438);
//       std::io::write(fd, "hello", 5);
//       std::io::close(fd);
//
//       std::io::exit(0);
//       return 0;
//   }

module "std::io";

// Linux syscall numbers:
//   read = 0, write = 1, close = 3, lseek = 8, exit = 60,
//   fsync = 74, openat = 257 (AT_FDCWD = -100)

@syscall(0) extern func sys_read(fd: i64, buf: str, len: i64) i64;
@syscall(1) extern func sys_write(fd: i64, buf: str, len: i64) i64;
@syscall(3) extern func sys_close(fd: i64) i64;
@syscall(8) extern func sys_lseek(fd: i64, offset: i64, whence: i64) i64;
@syscall(60) extern func sys_exit(code: i64) void;
@syscall(74) extern func sys_fsync(fd: i64) i64;
@syscall(257) extern func sys_openat(dirfd: i64, path: str, flags: i64, mode: i64) i64;

// strlen - get string length (without \0).
func strlen(s: str) i64 {
    p: *i8 = s as! *i8;
    mut i: i32 = 0;
    while (true) {
        c: i8 = p[i];
        if (c == (0 as i8)) { return i as i64; }
        i = i + 1;
    }
    return 0;
}

// print - print string to stdout.
func print(text: str) void {
    n: i64 = strlen(text);
    sys_write(1, text, n);
}

// println - print string + newline to stdout.
func println(text: str) void {
    print(text);
    print_char(10);
}

// eprint - print string to stderr.
func eprint(text: str) void {
    n: i64 = strlen(text);
    sys_write(2, text, n);
}

// print_char - print one byte to stdout.
struct PutcBuf { c: i8; };
@init mut g_putc_buf: PutcBuf;

func print_char(c: i8) void {
    g_putc_buf.c = c;
    sys_write(1, (&g_putc_buf) as! str, 1);
}

// exit - exit program with the given code.
func exit(code: i32) void {
    sys_exit(code as i64);
}

// open - open file, returns fd. flags: 65 = O_RDWR|O_CREAT, mode: 438 = 0666.
func open(path: str, flags: i32, mode: i32) i64 {
    r: i64 = sys_openat(-100, path, flags as i64, mode as i64);
    if (r < (0 as i64)) { return (0 as i64) - r; }
    return r;
}

// close - close file descriptor.
func close(fd: i64) i64 {
    r: i64 = sys_close(fd);
    if (r < (0 as i64)) { return (0 as i64) - r; }
    return r;
}

// seek - seek in file.
func seek(fd: i64, offset: i64, whence: i32) i64 {
    r: i64 = sys_lseek(fd, offset, whence as i64);
    if (r < (0 as i64)) { return (0 as i64) - r; }
    return r;
}

// flush - flush file.
func flush(fd: i64) i64 {
    r: i64 = sys_fsync(fd);
    if (r < (0 as i64)) { return (0 as i64) - r; }
    return r;
}

// write - write bytes to fd.
func write(fd: i64, buf: str, len: i64) i64 {
    r: i64 = sys_write(fd, buf, len);
    if (r < (0 as i64)) { return (0 as i64) - r; }
    return r;
}

// read_fd - read bytes from fd.
func read_fd(fd: i64, buf: str, len: i64) i64 {
    r: i64 = sys_read(fd, buf, len);
    if (r < (0 as i64)) { return (0 as i64) - r; }
    return r;
}

// read - read from stdin.
func read(buf: str, len: i64) i64 {
    r: i64 = sys_read(0, buf, len);
    if (r < (0 as i64)) { return (0 as i64) - r; }
    return r;
}

// read_char - read one byte from stdin.
func read_char() i64 {
    n: i64 = sys_read(0, (&g_putc_buf) as! str, 1);
    if (n <= (0 as i64)) { return -1; }
    return g_putc_buf.c as i64;
}
