// std::arena
//
// Region (bump pointer) allocator built on top of mmap/munmap.
// Pure Quant implementation.
//
// Usage:
//   load "std::arena";
//
//   mut std::arena::Region r = std::arena::_create(1024);
//   *i32 p = std::arena::_region_bump(&r, 4) as! *i32;
//   p[0] = 42;
//   std::arena::_destroy(&r);

module "std::arena";

@syscall(9) extern i64 sys_mmap(u64 addr, u64 length, i64 prot, i64 flags, i64 fd, i64 offset);
@syscall(11) extern i64 sys_munmap(u64 addr, u64 length);

struct Region {
    *void data;
    u64 offset;
    u64 capacity;
};

@init mut Region g_global_region;

// _region_mmap - map `size` bytes of anonymous read/write memory.
*void _region_mmap(u64 size) {
    mut i64 r = sys_mmap(0 as u64, size, 3 as i64, (34 as i64), (-1 as i64), 0 as i64);
    if (r < (0 as i64)) { return 0 as! *void; }
    return (r as u64) as! *void;
}

// _region_munmap - unmap `size` bytes previously returned by _region_mmap.
void _region_munmap(*void ptr, u64 size) {
    if (ptr == (0 as! *void)) { return; }
    sys_munmap((ptr as! u64), size);
}

// _region_bump - allocate `size` bytes from a region (16-byte aligned).
// Returns NULL if the region has no space left.
*void _region_bump(mut &Region reg, u64 size) {
    mut u64 a = size + (15 as u64);
    a = a & ((-16 as i64) as u64);
    u64 off = reg.offset;
    u64 end = off + a;
    if (end > reg.capacity) { return 0 as! *void; }
    u64 res = (reg.data as! u64) + off;
    reg.offset = end;
    return res as! *void;
}

// _create - create a new region backed by an mmap'd block of `size` bytes.
Region _create(u64 size) {
    mut Region r;
    r.data = _region_mmap(size);
    r.offset = 0;
    r.capacity = size;
    return r;
}

// _destroy - unmap the backing memory of a region.
void _destroy(mut &Region reg) {
    _region_munmap(reg.data, reg.capacity);
    reg.data = 0 as! *void;
    reg.offset = 0;
    reg.capacity = 0;
}

// _global_region - returns the process-wide region used by std::string.
&Region _global_region() {
    return &g_global_region;
}

// _init_global_region - (re)allocate the global region backing memory.
void _init_global_region(u64 size) {
    if (g_global_region.data != (0 as! *void)) {
        _region_munmap(g_global_region.data, g_global_region.capacity);
        g_global_region.data = 0 as! *void;
    }
    g_global_region.data = _region_mmap(size);
    g_global_region.offset = 0;
    g_global_region.capacity = size;
}
