// std::cmp
//
// Comparison utilities. Returns an `ordering` value instead of raw numbers.
//
// ordering.tag: -1 = less, 0 = equal, 1 = greater
//
// Usage:
//   load "std::cmp";
//
//   i32 main() {
//       ordering r = cmp<i32>(10, 20);
//       if (cmp_is_less(r)) {
//           std::io::print("less");
//       }
//
//       ordering r2 = cmp<i32>(5, 5);
//       if (cmp_is_equal(r2)) {
//           std::io::print("equal");
//       }
//       return 0;
//   }

module "std::cmp";

// A simple struct that holds comparison result.
//   tag == -1 means less
//   tag == 0  means equal
//   tag == 1  means greater
struct ordering {
    i32 tag = 0;
};

// cmp_less - create "less" ordering value.
ordering cmp_less() {
    @init mut ordering o;
    o.tag = -1;
    return o;
}

// cmp_equal - create "equal" ordering value.
ordering cmp_equal() {
    @init mut ordering o;
    o.tag = 0;
    return o;
}

// cmp_greater - create "greater" ordering value.
ordering cmp_greater() {
    @init mut ordering o;
    o.tag = 1;
    return o;
}

// cmp_is_less - check if ordering is "less".
bool cmp_is_less(ordering o) {
    return o.tag == -1;
}

// cmp_is_equal - check if ordering is "equal".
bool cmp_is_equal(ordering o) {
    return o.tag == 0;
}

// cmp_is_greater - check if ordering is "greater".
bool cmp_is_greater(ordering o) {
    return o.tag == 1;
}

// cmp<T> - compare two values of any type, returns ordering.
ordering cmp<T>(T a, T b) {
    if (a < b) { return cmp_less(); }
    if (a > b) { return cmp_greater(); }
    return cmp_equal();
}

// cmp_reverse - flip the ordering (less <-> greater, equal stays).
ordering cmp_reverse(ordering o) {
    if (o.tag == -1) { return cmp_greater(); }
    if (o.tag == 1) { return cmp_less(); }
    return cmp_equal();
}

// cmp_then - if `a` is equal, use `b` as tiebreaker.
ordering cmp_then(ordering a, ordering b) {
    if (a.tag != 0) { return a; }
    return b;
}
