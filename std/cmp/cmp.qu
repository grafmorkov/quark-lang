// std::cmp
//
// Comparison utilities. Returns an `ordering` value instead of raw numbers.
//
// ordering.tag: -1 = less, 0 = equal, 1 = greater
//
// Usage:
//   load "std::cmp";
//
//   func main() i32 {
//       r: ordering = cmp<i32>(10, 20);
//       if (cmp_is_less(r)) {
//           std::io::print("less");
//       }
//
//       r2: ordering = cmp<i32>(5, 5);
//       if (cmp_is_equal(r2)) {
//           std::io::print("equal");
//       }
//       return 0;
//   }

module "std::cmp";

// A simple struct that holds comparison result.
//   tag == -1 means less
//   tag == 0  means equal
//   tag == 1  means greater
struct ordering {
    tag: i32 = 0;
};

// cmp_less - create "less" ordering value.
func cmp_less() ordering {
    @init mut o: ordering;
    o.tag = -1;
    return o;
}

// cmp_equal - create "equal" ordering value.
func cmp_equal() ordering {
    @init mut o: ordering;
    o.tag = 0;
    return o;
}

// cmp_greater - create "greater" ordering value.
func cmp_greater() ordering {
    @init mut o: ordering;
    o.tag = 1;
    return o;
}

// cmp_is_less - check if ordering is "less".
func cmp_is_less(o: ordering) bool {
    return o.tag == -1;
}

// cmp_is_equal - check if ordering is "equal".
func cmp_is_equal(o: ordering) bool {
    return o.tag == 0;
}

// cmp_is_greater - check if ordering is "greater".
func cmp_is_greater(o: ordering) bool {
    return o.tag == 1;
}

// cmp<T> - compare two values of any type, returns ordering.
func cmp<T>(a: T, b: T) ordering {
    if (a < b) { return cmp_less(); }
    if (a > b) { return cmp_greater(); }
    return cmp_equal();
}

// cmp_reverse - flip the ordering (less <-> greater, equal stays).
func cmp_reverse(o: ordering) ordering {
    if (o.tag == -1) { return cmp_greater(); }
    if (o.tag == 1) { return cmp_less(); }
    return cmp_equal();
}

// cmp_then - if `a` is equal, use `b` as tiebreaker.
func cmp_then(a: ordering, b: ordering) ordering {
    if (a.tag != 0) { return a; }
    return b;
}
