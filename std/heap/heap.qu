// std::heap
//
// Heap memory allocator (malloc/free/realloc).
// Pure Quant implementation using mmap/munmap.
//
// Uses a first-fit free-list on top of mmap'd chunks.
// Each block has a 16-byte header:
//   [+0] size_flags (u64) - total block size, bit 0 = 1 if allocated
//   [+8] next (u64)       - next free block (only valid when free)
// User data starts at +16 and is 16-byte aligned.
// Minimum block size = 32 bytes.
//
// Usage:
//   load "std::heap";
//
//   i32 main() {
//       *i32 p = std::heap::heap_malloc(4) as! *i32;
//       p[0] = 42;
//       p = std::heap::heap_realloc(p as! *void, 8) as! *i32;
//       std::heap::heap_free(p as! *void);
//       return 0;
//   }

module "std::heap";

@syscall(9) extern i64 sys_mmap(u64 addr, u64 length, i64 prot, i64 flags, i64 fd, i64 offset);

@init mut u64 heap_head;

// Try to satisfy the allocation from the existing free list.
// Returns NULL if no free block is big enough.
*void alloc_from_list(u64 need) {
    mut u64 rbx = heap_head;
    mut u64 prev = 0;
    while (rbx != (0 as u64)) {
        mut u64 sz = (rbx as! *u64)[0];
        sz = sz & ((-2 as i64) as u64);
        if (sz >= need) {
            u64 rest = sz - need;
            if (rest < (32 as u64)) {
                // Exact fit: unlink from free list
                (rbx as! *u64)[0] = sz | (1 as u64);
                u64 nxt = (rbx as! *u64)[1];
                if (prev == (0 as u64)) {
                    heap_head = nxt;
                } else {
                    (prev as! *u64)[1] = nxt;
                }
                return ((rbx + (16 as u64)) as! *void);
            }
            // Split from the end: keep free block at rbx, take from top
            (rbx as! *u64)[0] = rest;
            u64 used = rbx + rest;
            (used as! *u64)[0] = need | (1 as u64);
            return ((used + (16 as u64)) as! *void);
        }
        prev = rbx;
        rbx = (rbx as! *u64)[1];
    }
    return 0 as! *void;
}

// mmap a new chunk and add it to the free list as a free block.
// The chunk is CHUNK_SIZE - 2*MIN_BLOCK bytes, followed by a guard
// block so free/realloc never reads past the mmap region.
bool refill() {
    mut i64 r = sys_mmap(0 as u64, (65536 as u64), 3 as i64, (34 as i64), (-1 as i64), 0 as i64);
    if (r < (0 as i64)) { return false; }
    u64 chunk = r as u64;
    u64 size = (65536 as u64) - (64 as u64);
    (chunk as! *u64)[0] = size;
    (chunk as! *u64)[1] = heap_head;
    heap_head = chunk;
    u64 guard = chunk + size;
    (guard as! *u64)[0] = 1 as u64;
    return true;
}

// heap_malloc - allocate `size` bytes. Returns 16-byte aligned pointer, or NULL.
*void heap_malloc(u64 size) {
    mut u64 need = size + (31 as u64);
    need = need & ((-16 as i64) as u64);
    if (need < (32 as u64)) { need = 32 as u64; }
    while (true) {
        *void p = alloc_from_list(need);
        if (p != (0 as! *void)) { return p; }
        bool ok = refill();
        if (!ok) { return 0 as! *void; }
    }
    return 0 as! *void;
}

// heap_free - free a pointer previously returned by heap_malloc/realloc.
// free(NULL) is a no-op.
void heap_free(*void ptr) {
    if (ptr == (0 as! *void)) { return; }
    mut u64 rbx = (ptr as! u64) - (16 as u64);

    // Mark as free
    mut u64 sz = (rbx as! *u64)[0];
    sz = sz & ((-2 as i64) as u64);
    (rbx as! *u64)[0] = sz;

    // Try to coalesce with the next physical block
    u64 rcx = rbx + sz;
    mut u64 nf = (rcx as! *u64)[0];
    if ((nf & (1 as u64)) == (0 as u64)) {
        // Next block is free - find it in the free list and unlink it
        mut u64 rdx = heap_head;
        mut u64 r8 = 0;
        mut bool stop = false;
        while (!stop) {
            if (rdx == rcx) {
                stop = true;
            } else {
                if (rdx == (0 as u64)) {
                    stop = true;
                    rdx = (0 as u64) - (1 as u64);  // not found marker
                } else {
                    r8 = rdx;
                    rdx = (rdx as! *u64)[1];
                }
            }
        }
        if (rdx == rcx) {
            u64 nxt = (rcx as! *u64)[1];
            if (r8 == (0 as u64)) {
                heap_head = nxt;
            } else {
                (r8 as! *u64)[1] = nxt;
            }
            mut u64 ns = nf & ((-2 as i64) as u64);
            (rbx as! *u64)[0] = sz + ns;
        }
    }

    // Insert this block at head of free list
    (rbx as! *u64)[1] = heap_head;
    heap_head = rbx;
}

// heap_realloc - resize an allocation. May move the data.
// Returns the new pointer, or NULL on OOM.
*void heap_realloc(*void ptr, u64 new_size) {
    if (ptr == (0 as! *void)) { return heap_malloc(new_size); }
    if (new_size == (0 as u64)) {
        heap_free(ptr);
        return 0 as! *void;
    }

    mut u64 old = ptr as! u64;
    u64 rbx = old - (16 as u64);
    mut u64 o_sz = (rbx as! *u64)[0];
    o_sz = o_sz & ((-2 as i64) as u64);

    mut u64 need = new_size + (31 as u64);
    need = need & ((-16 as i64) as u64);
    if (need < (32 as u64)) { need = 32 as u64; }

    // New size fits in the old block - done (maybe shrink)
    if (need <= o_sz) {
        u64 rest = o_sz - need;
        if (rest >= (32 as u64)) {
            // Split: create a free block after the shrunken allocation
            u64 nb = rbx + need;
            (rbx as! *u64)[0] = need | (1 as u64);
            (nb as! *u64)[0] = rest;
            heap_free(((nb + (16 as u64)) as! *void));
        }
        return ptr;
    }

    // Try to extend into the next physical block if it is free
    u64 next = rbx + o_sz;
    mut u64 nf = (next as! *u64)[0];
    if ((nf & (1 as u64)) == (0 as u64)) {
        u64 ns = nf & ((-2 as i64) as u64);
        if ((o_sz + ns) >= need) {
            // Unlink the next block from the free list
            mut u64 rdx = heap_head;
            mut u64 r9 = 0;
            mut bool stop2 = false;
            while (!stop2) {
                if (rdx == next) {
                    stop2 = true;
                } else {
                    if (rdx == (0 as u64)) {
                        stop2 = true;
                        rdx = (0 as u64) - (1 as u64);
                    } else {
                        r9 = rdx;
                        rdx = (rdx as! *u64)[1];
                    }
                }
            }
            if (rdx == next) {
                u64 nxt2 = (next as! *u64)[1];
                if (r9 == (0 as u64)) {
                    heap_head = nxt2;
                } else {
                    (r9 as! *u64)[1] = nxt2;
                }
                // Merge and mark as used
                (rbx as! *u64)[0] = (o_sz + ns) | (1 as u64);
                // Shrink if the combined block is larger than needed
                u64 rest2 = (o_sz + ns) - need;
                if (rest2 >= (32 as u64)) {
                    u64 nb2 = rbx + need;
                    (rbx as! *u64)[0] = need | (1 as u64);
                    (nb2 as! *u64)[0] = rest2;
                    heap_free(((nb2 + (16 as u64)) as! *void));
                }
            }
            return ptr;
        }
    }

    // Allocate a new block and move the data
    *void nptr = heap_malloc(new_size);
    if (nptr == (0 as! *void)) { return 0 as! *void; }

    mut u64 o_usable = o_sz - (16 as u64);
    mut u64 n_usable = need - (16 as u64);
    mut u64 len = o_usable;
    if (n_usable < len) { len = n_usable; }

    u64 dst = nptr as! u64;
    mut u64 i = 0;
    while (i < len) {
        ((dst + i) as! *u8)[0] = ((old + i) as! *u8)[0];
        i = i + (1 as u64);
    }

    heap_free(ptr);
    return nptr;
}
