// std::string
//
// String functions. Pure Quant implementation.
// str_concat, str_sub, str_copy allocate memory from a caller-provided
// region (std::arena::Region). See std/arena/arena.qu for _create/_destroy.
//
// Usage:
//   load "std::string";
//   load "std::arena";
//
//   i32 main() {
//       str s = "hello";
//       std::io::print(str_len(s) as str);        // 5
//       std::io::print(str_eq(s, "hello") as str); // 1 (true)
//
//       mut std::arena::Region r = std::arena::_create(1024);
//
//       str sub = str_sub(&r, s, 1, 3);           // "ell"
//       std::io::print(sub);
//
//       str cat = str_concat(&r, s, " world");    // "hello world"
//       std::io::print(cat);
//
//       u8 c = str_char_at(s, 0);                 // 'h'
//       std::io::print_char(c);
//       std::arena::_destroy(&r);
//       return 0;
//   }

module "std::string";

load "std::arena";

// str_len - length of a string (without the terminating \0).
u64 str_len(str s) {
    *u8 b = s as! *u8;
    mut u64 i = 0;
    while (b[i] != 0) {
        i++;
    }
    return i;
}

// str_eq - check if two strings are equal.
bool str_eq(str a, str b) {
    *u8 pa = a as! *u8;
    *u8 pb = b as! *u8;
    mut u64 i = 0;
    while (true) {
        u8 ca = pa[i];
        u8 cb = pb[i];
        if (ca != cb) { return false; }
        if (ca == 0) { return true; }
        i++;
    }
    return false;
}

// str_neq - check if two strings are different.
bool str_neq(str a, str b) {
    return !str_eq(a, b);
}

// str_empty - check if a string is empty.
bool str_empty(str s) {
    *u8 b = s as! *u8;
    return b[0] == 0;
}

// str_char_at - get the byte at `index`.
u8 str_char_at(str s, u64 index) {
    *u8 b = s as! *u8;
    return b[index];
}

// str_concat - concatenate two strings (arena-allocated).
str str_concat(mut &std::arena::Region r, str a, str b) {
    u64 la = str_len(a);
    u64 lb = str_len(b);
    *u8 buf = r.bump(la + lb + 1) as! *u8;
    if (buf == (0 as! *u8)) { return (0 as! *u8) as! str; }
    *u8 pa = a as! *u8;
    *u8 pb = b as! *u8;
    for (mut u64 i = 0; i < la; i++) {
        buf[i] = pa[i];
    }
    // Copy b including its trailing \0.
    for (mut u64 j = 0; j <= lb; j++) {
        buf[la + j] = pb[j];
    }
    return buf as! str;
}

// str_sub - extract a substring starting at `start` with length `len`.
str str_sub(mut &std::arena::Region r, str s, u64 start, u64 len) {
    *u8 buf = r.bump(len + 1) as! *u8;
    if (buf == (0 as! *u8)) { return (0 as! *u8) as! str; }
    *u8 b = s as! *u8;
    for (mut u64 i = 0; i < len; i++) {
        buf[i] = b[start + i];
    }
    buf[len] = 0;
    return buf as! str;
}

// str_copy - copy a string (arena-allocated).
str str_copy(mut &std::arena::Region r, str s) {
    u64 n = str_len(s);
    *u8 buf = r.bump(n + 1) as! *u8;
    if (buf == (0 as! *u8)) { return (0 as! *u8) as! str; }
    *u8 b = s as! *u8;
    for (mut u64 i = 0; i <= n; i++) {
        buf[i] = b[i];
    }
    return buf as! str;
}
