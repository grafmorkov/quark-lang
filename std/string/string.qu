// std::string
//
// String functions. Pure Quant implementation.
// str_concat, str_sub, str_copy allocate memory from the global arena
// (std::arena). See std/arena/arena.qu for _init_global_region.
//
// Usage:
//   load "std::string";
//
//   i32 main() {
//       str s = "hello";
//       std::io::print(str_len(s) as str);        // 5
//       std::io::print(str_eq(s, "hello") as str); // 1 (true)
//
//       sub: str = str_sub(s, 1, 3);              // "ell"
//       std::io::print(sub);
//
//       cat: str = str_concat(s, " world");       // "hello world"
//       std::io::print(cat);
//
//       c: char = str_char_at(s, 0);              // 'h'
//       std::io::print_char(c as i8);
//       return 0;
//   }

module "std::string";

load "std::arena";

// str_len - length of string (without terminating \0).
u64 str_len(str s) {
    *u8 b = s as! *u8;
    mut u64 i = 0;
    while (b[i] != (0 as u8)) {
        i = i + (1 as u64);
    }
    return i;
}

// str_eq - check if two strings are equal.
bool str_eq(str a, str b) {
    *u8 pa = a as! *u8;
    *u8 pb = b as! *u8;
    mut u64 i = 0;
    while (true) {
        u8 ca = pa[i];
        u8 cb = pb[i];
        if (ca != cb) { return false; }
        if (ca == (0 as u8)) { return true; }
        i = i + (1 as u64);
    }
    return false;
}

// str_neq - check if two strings are different.
bool str_neq(str a, str b) {
    if (str_eq(a, b)) { return false; }
    return true;
}

// str_empty - check if string is empty.
bool str_empty(str s) {
    *u8 b = s as! *u8;
    if (b[0] == (0 as u8)) { return true; }
    return false;
}

// str_char_at - get byte at index.
u8 str_char_at(str s, u64 index) {
    *u8 b = s as! *u8;
    return b[index];
}

// str_concat - concatenate two strings (arena-allocated).
str str_concat(str a, str b) {
    u64 la = str_len(a);
    u64 lb = str_len(b);
    *u8 buf = std::arena::_region_bump(std::arena::_global_region(), la + lb + (1 as u64)) as! *u8;
    if (buf == (0 as! *u8)) { return (0 as! *u8) as! str; }
    *u8 pa = a as! *u8;
    *u8 pb = b as! *u8;
    mut u64 i = 0;
    while (i < la) {
        buf[i] = pa[i];
        i = i + (1 as u64);
    }
    // Copy b including its trailing \0
    mut u64 j = 0;
    while (j <= lb) {
        buf[la + j] = pb[j];
        j = j + (1 as u64);
    }
    return buf as! str;
}

// str_sub - extract substring from start with given length (arena-allocated).
str str_sub(str s, u64 start, u64 len) {
    *u8 buf = std::arena::_region_bump(std::arena::_global_region(), len + (1 as u64)) as! *u8;
    if (buf == (0 as! *u8)) { return (0 as! *u8) as! str; }
    *u8 b = s as! *u8;
    mut u64 i = 0;
    while (i < len) {
        buf[i] = b[start + i];
        i = i + (1 as u64);
    }
    buf[len] = 0 as u8;
    return buf as! str;
}

// str_copy - copy a string (arena-allocated).
str str_copy(str s) {
    u64 n = str_len(s);
    *u8 buf = std::arena::_region_bump(std::arena::_global_region(), n + (1 as u64)) as! *u8;
    if (buf == (0 as! *u8)) { return (0 as! *u8) as! str; }
    *u8 b = s as! *u8;
    mut u64 i = 0;
    while (i <= n) {
        buf[i] = b[i];
        i = i + (1 as u64);
    }
    return buf as! str;
}
