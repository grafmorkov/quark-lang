// std::string
//
// String functions. Pure Quant implementation.
// str_concat, str_sub, str_copy allocate memory from the global arena
// (std::arena). See std/arena/arena.qu for _init_global_region.
//
// Usage:
//   load "std::string";
//
//   func main() i32 {
//       s: str = "hello";
//       std::io::print(str_len(s) as str);        // 5
//       std::io::print(str_eq(s, "hello") as str); // 1 (true)
//
//       sub: str = str_sub(s, 1, 3);              // "ell"
//       std::io::print(sub);
//
//       cat: str = str_concat(s, " world");       // "hello world"
//       std::io::print(cat);
//
//       c: char = str_char_at(s, 0);              // 'h'
//       std::io::print_char(c as i8);
//       return 0;
//   }

module "std::string";

load "std::arena";

// str_len - length of string (without terminating \0).
func str_len(s: str) u64 {
    b: *u8 = s as! *u8;
    mut i: u64 = 0;
    while (b[i] != (0 as u8)) {
        i = i + (1 as u64);
    }
    return i;
}

// str_eq - check if two strings are equal.
func str_eq(a: str, b: str) bool {
    pa: *u8 = a as! *u8;
    pb: *u8 = b as! *u8;
    mut i: u64 = 0;
    while (true) {
        ca: u8 = pa[i];
        cb: u8 = pb[i];
        if (ca != cb) { return false; }
        if (ca == (0 as u8)) { return true; }
        i = i + (1 as u64);
    }
    return false;
}

// str_neq - check if two strings are different.
func str_neq(a: str, b: str) bool {
    if (str_eq(a, b)) { return false; }
    return true;
}

// str_empty - check if string is empty.
func str_empty(s: str) bool {
    b: *u8 = s as! *u8;
    if (b[0] == (0 as u8)) { return true; }
    return false;
}

// str_char_at - get byte at index.
func str_char_at(s: str, index: u64) u8 {
    b: *u8 = s as! *u8;
    return b[index];
}

// str_concat - concatenate two strings (arena-allocated).
func str_concat(a: str, b: str) str {
    la: u64 = str_len(a);
    lb: u64 = str_len(b);
    buf: *u8 = std::arena::_region_bump(std::arena::_global_region(), la + lb + (1 as u64)) as! *u8;
    if (buf == (0 as! *u8)) { return (0 as! *u8) as! str; }
    pa: *u8 = a as! *u8;
    pb: *u8 = b as! *u8;
    mut i: u64 = 0;
    while (i < la) {
        buf[i] = pa[i];
        i = i + (1 as u64);
    }
    // Copy b including its trailing \0
    mut j: u64 = 0;
    while (j <= lb) {
        buf[la + j] = pb[j];
        j = j + (1 as u64);
    }
    return buf as! str;
}

// str_sub - extract substring from start with given length (arena-allocated).
func str_sub(s: str, start: u64, len: u64) str {
    buf: *u8 = std::arena::_region_bump(std::arena::_global_region(), len + (1 as u64)) as! *u8;
    if (buf == (0 as! *u8)) { return (0 as! *u8) as! str; }
    b: *u8 = s as! *u8;
    mut i: u64 = 0;
    while (i < len) {
        buf[i] = b[start + i];
        i = i + (1 as u64);
    }
    buf[len] = 0 as u8;
    return buf as! str;
}

// str_copy - copy a string (arena-allocated).
func str_copy(s: str) str {
    n: u64 = str_len(s);
    buf: *u8 = std::arena::_region_bump(std::arena::_global_region(), n + (1 as u64)) as! *u8;
    if (buf == (0 as! *u8)) { return (0 as! *u8) as! str; }
    b: *u8 = s as! *u8;
    mut i: u64 = 0;
    while (i <= n) {
        buf[i] = b[i];
        i = i + (1 as u64);
    }
    return buf as! str;
}
