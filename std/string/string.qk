// std::string
//
// String functions. Implemented in qkrt (runtime assembly).
// str_concat, str_sub, str_copy allocate memory from the global arena.
//
// Usage:
//   load "std::string";
//
//   func main() i32 {
//       s: str = "hello";
//       std::io::print(str_len(s) as str);        // 5
//       std::io::print(str_eq(s, "hello") as str); // 1 (true)
//
//       sub: str = str_sub(s, 1, 3);              // "ell"
//       std::io::print(sub);
//
//       cat: str = str_concat(s, " world");       // "hello world"
//       std::io::print(cat);
//
//       c: char = str_char_at(s, 0);              // 'h'
//       std::io::print_char(c as i8);
//       return 0;
//   }

@link("string") module "std::string";

extern func str_len(s: str) i64; // str_len - length of string (without \0).
extern func str_eq(a: str, b: str) bool; // str_eq - check if two strings are equal.
extern func str_neq(a: str, b: str) bool; // str_neq - check if two strings are different.
extern func str_empty(s: str) bool; // str_empty - check if string is empty.
extern func str_char_at(s: str, index: i64) char; // str_char_at - get byte at index.
extern func str_concat(a: str, b: str) str; // str_concat - concatenate two strings (arena-allocated).
extern func str_sub(s: str, start: i64, len: i64) str; // str_sub - extract substring from start with given length (arena-allocated).
extern func str_copy(s: str) str; // str_copy - copy a string (arena-allocated).
