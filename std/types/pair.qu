// std::types - pair<A, B>
//
// A simple pair of two values.
//
// Usage:
//   load "std::types";
//
//   i32 main() {
//       pair<i32, str> p = pair<i32, str>{ 42, "hello" };
//       std::io::print(p.first as str);
//       return 0;
//   }

module "std::types";

struct pair<A,B> {
    A first;
    B second;
};
