// std::types - option<T>
//
// Optional value. Either contains something or nothing.
// `has_value` starts as false. The @guard on `value` means you can't
// read it when `has_value` is false.
//
// Usage:
//   load "std::types";
//
//   option<i32> find(i32 x) {
//       if (x > 0) { return option_some<i32>(x * 2); }
//       return option_none<i32>();
//   }
//
//   i32 main() {
//       option<i32> r = find(5);
//       if (r.is_some()) {
//           std::io::print(r.unwrap() as str);
//       }
//       return 0;
//   }

module "std::types";

struct option<T> {
    bool has_value = false;

    @init @guard(has_value)
    T value;

    // is_some - true if this option holds a value.
    bool is_some() {
        return has_value;
    }

    // is_none - true if this option is empty.
    bool is_none() {
        return !has_value;
    }

    // unwrap - get the value (undefined behaviour when empty).
    T unwrap() {
        return value;
    }

    // unwrap_or - get the value, or `dflt` when empty.
    T unwrap_or(T dflt) {
        if (has_value) {
            return value;
        }
        return dflt;
    }
};

// option_some - create an option with a value.
option<T> option_some<T>(T val) {
    @init mut option<T> o;
    o.has_value = true;
    o.value = val;
    return o;
}

// option_none - create an empty option.
option<T> option_none<T>() {
    @init mut option<T> o;
    o.has_value = false;
    return o;
}

// --- Deprecated free-function wrappers. Prefer the option<T> methods. ---

// option_is_some - check if it has a value.
bool option_is_some<T>(option<T> o) {
    return o.is_some();
}

// option_is_none - check if it's empty.
bool option_is_none<T>(option<T> o) {
    return o.is_none();
}

// option_unwrap - get the value (panics if none).
T option_unwrap<T>(option<T> o) {
    return o.unwrap();
}

// option_unwrap_or - get the value, or use `dflt` if it's none.
T option_unwrap_or<T>(option<T> o, T dflt) {
    return o.unwrap_or(dflt);
}
