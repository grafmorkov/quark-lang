// std::types - opt<T>
//
// Optional value. Either contains something or nothing.
// `has_value` starts as false. The @guard on `value` means you can't
// read it when `has_value` is false.
//
// Usage:
//   load "std::types";
//
//   opt<i32> find(i32 x) {
//       if (x > 0) { return opt_some<i32>(x * 2); }
//       return opt_none<i32>();
//   }
//
//   i32 main() {
//       opt<i32> r = find(5);
//       if (opt_is_some(r)) {
//           std::io::print(opt_unwrap(r) as str);
//       }
//       return 0;
//   }

module "std::types";

struct opt<T> {
    bool has_value = false;

    @init @guard(has_value)
    T value;
};

// opt_some - create an option with a value.
opt<T> opt_some<T>(T val) {
    @init mut opt<T> o;
    o.has_value = true;
    o.value = val;
    return o;
}

// opt_none - create an empty option.
opt<T> opt_none<T>() {
    @init mut opt<T> o;
    o.has_value = false;
    return o;
}

// opt_is_some - check if it has a value.
bool opt_is_some<T>(opt<T> o) {
    return o.has_value;
}

// opt_is_none - check if it's empty.
bool opt_is_none<T>(opt<T> o) {
    return !o.has_value;
}

// opt_unwrap - get the value (panics if none).
T opt_unwrap<T>(opt<T> o) {
    return o.value;
}

// opt_unwrap_or - get the value, or use `dflt` if it's none.
T opt_unwrap_or<T>(opt<T> o, T dflt) {
    if (o.has_value) {
        return o.value;
    }
    return dflt;
}
