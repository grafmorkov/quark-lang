// std::types - result<T, E>
//
// Result of an operation that can fail.
// Either ok with a value or err with an error.
// `is_ok` starts as false. @guard blocks reading `ok_value` when is_ok
// is false, and `err_value` when is_ok is true.
//
// Usage:
//   load "std::types";
//
//   result<i32, str> divide(i32 a, i32 b) {
//       if (b == 0) { return result_err<i32, str>("division by zero"); }
//       return result_ok<i32, str>(a / b);
//   }
//
//   i32 main() {
//       result<i32, str> r = divide(10, 3);
//       if (result_is_ok(r)) {
//           std::io::print(result_unwrap_ok(r) as str);
//       }
//       return 0;
//   }

module "std::types";

struct result<T, E> {
    bool is_ok = false;

    @init @guard(is_ok)
    T ok_value;

    @init @guard(!is_ok)
    E err_value;
};

// result_ok - create an ok result with a value.
result<T, E> result_ok<T, E>(T val) {
    @init mut result<T, E> r;
    r.is_ok = true;
    r.ok_value = val;
    return r;
}

// result_err - create an error result.
result<T, E> result_err<T, E>(E err) {
    @init mut result<T, E> r;
    r.is_ok = false;
    r.err_value = err;
    return r;
}

// result_is_ok - check if result is ok.
bool result_is_ok<T, E>(result<T, E> r) {
    return r.is_ok;
}

// result_is_err - check if result is error.
bool result_is_err<T, E>(result<T, E> r) {
    return !r.is_ok;
}

// result_unwrap_ok - get the ok value.
T result_unwrap_ok<T, E>(result<T, E> r) {
    return r.ok_value;
}

// result_unwrap_err - get the error value.
E result_unwrap_err<T, E>(result<T, E> r) {
    return r.err_value;
}

// result_unwrap_or - get the ok value or use default if error.
T result_unwrap_or<T, E>(result<T, E> r, T default) {
    if (r.is_ok) {
        return r.ok_value;
    }
    return default;
}
