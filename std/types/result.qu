// std::types - result<T, E>
//
// Result of an operation that can fail.
// Either ok with a value or err with an error.
// `is_ok` starts as false. @guard blocks reading `ok_value` when is_ok
// is false, and `err_value` when is_ok is true.
//
// Usage:
//   load "std::types";
//
//   result<i32, str> divide(i32 a, i32 b) {
//       if (b == 0) { return result_err<i32, str>("division by zero"); }
//       return result_ok<i32, str>(a / b);
//   }
//
//   i32 main() {
//       result<i32, str> r = divide(10, 3);
//       if (r.is_ok()) {
//           std::io::print(r.unwrap() as str);
//       }
//       return 0;
//   }

module "std::types";

struct result<T, E> {
    bool is_ok = false;

    @init @guard(is_ok)
    T ok_value;

    @init @guard(!is_ok)
    E err_value;

    // is_ok - true if this result holds an ok value.
    bool is_ok() {
        return is_ok;
    }

    // is_err - true if this result holds an error.
    bool is_err() {
        return !is_ok;
    }

    // unwrap - get the ok value (undefined behaviour when it's an error).
    T unwrap() {
        return ok_value;
    }

    // unwrap_err - get the error value (undefined behaviour when it's ok).
    E unwrap_err() {
        return err_value;
    }

    // unwrap_or - get the ok value, or `dflt` when it's an error.
    T unwrap_or(T dflt) {
        if (is_ok) {
            return ok_value;
        }
        return dflt;
    }
};

// result_ok - create an ok result with a value.
result<T, E> result_ok<T, E>(T val) {
    @init mut result<T, E> r;
    r.is_ok = true;
    r.ok_value = val;
    return r;
}

// result_err - create an error result.
result<T, E> result_err<T, E>(E err) {
    @init mut result<T, E> r;
    r.is_ok = false;
    r.err_value = err;
    return r;
}

// --- Deprecated free-function wrappers. Prefer the result<T, E> methods. ---

// result_is_ok - check if a result is ok.
bool result_is_ok<T, E>(result<T, E> r) {
    return r.is_ok();
}

// result_is_err - check if a result is an error.
bool result_is_err<T, E>(result<T, E> r) {
    return r.is_err();
}

// result_unwrap_ok - get the ok value.
T result_unwrap_ok<T, E>(result<T, E> r) {
    return r.unwrap();
}

// result_unwrap_err - get the error value.
E result_unwrap_err<T, E>(result<T, E> r) {
    return r.unwrap_err();
}

// result_unwrap_or - get the ok value, or use `dflt` if the result is an error.
T result_unwrap_or<T, E>(result<T, E> r, T dflt) {
    return r.unwrap_or(dflt);
}
