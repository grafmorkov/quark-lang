// std::types - either<L, R>
//
// A value that is one of two types. Like result but without ok/error semantics.
//
// Usage:
//   load "std::types";
//
//   func main() i32 {
//       e: either<i32, str> = either_left<i32, str>(42);
//       if (either_is_left(e)) {
//           std::io::print(either_unwrap_left(e) as str);
//       }
//       return 0;
//   }

module "std::types";

struct either<L, R> {
    is_left: bool = false;

    @init @guard(is_left)
    left_val: L;

    @init @guard(!is_left)
    right_val: R;
};

// either_left - create a left value.
func either_left<L, R>(val: L) either<L, R> {
    @init mut e: either<L, R>;
    e.is_left = true;
    e.left_val = val;
    return e;
}

// either_right - create a right value.
func either_right<L, R>(val: R) either<L, R> {
    @init mut e: either<L, R>;
    e.is_left = false;
    e.right_val = val;
    return e;
}

// either_is_left - check if it's a left value.
func either_is_left<L, R>(e: either<L, R>) bool {
    return e.is_left;
}

// either_is_right - check if it's a right value.
func either_is_right<L, R>(e: either<L, R>) bool {
    return !e.is_left;
}

// either_unwrap_left - get the left value.
func either_unwrap_left<L, R>(e: either<L, R>) L {
    return e.left_val;
}

// either_unwrap_right - get the right value.
func either_unwrap_right<L, R>(e: either<L, R>) R {
    return e.right_val;
}

// either_unwrap_left_or - get the left value or use default.
func either_unwrap_left_or<L, R>(e: either<L, R>, default: L) L {
    if (e.is_left) {
        return e.left_val;
    }
    return default;
}

// either_unwrap_right_or - get the right value or use default.
func either_unwrap_right_or<L, R>(e: either<L, R>, default: R) R {
    if (e.is_left) {
        return default;
    }
    return e.right_val;
}
