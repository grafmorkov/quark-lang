// std::vector
//
// Generic growable array backed by heap allocation.
//
// Usage:
//   load "std::vector";
//   using std::vector;
//
//   void main() {
//       @init mut Vec<i32> v;
//       v.push(10);
//       v.push(20);
//       v.push(30);
//       std::io::print(v.get(1) as str);  // 20
//       v.free();
//   }
//
// Notes:
//   - free must be called to release memory.
//   - get bounds are not checked.

module "std::vector";

load "std::heap";

struct Vec<T> {
    mut *T data;
    mut i32 size;
    mut i32 capacity;

    // push - append `val` to the end of the vector.
    void push(T val) {
        u64 elem_size = sizeof(T);
        if (capacity == 0) {
            data = std::heap::heap_malloc(elem_size) as! *T;
            capacity = 1;
        } else if (size >= capacity) {
            capacity *= 2;
            data = std::heap::heap_realloc(data as! *void, capacity * elem_size) as! *T;
        }
        data[size] = val;
        size++;
    }

    // get - read the element at `index` (unchecked).
    T get(i32 index) {
        return data[index];
    }

    // len - number of elements in the vector.
    u64 len() {
        return size as u64;
    }

    // free - release the backing allocation. free() on an empty vector
    // is a no-op.
    void free() {
        if (capacity > 0) {
            std::heap::heap_free(data as! *void);
            data = 0 as! *T;
            capacity = 0;
        }
    }
};

// --- Deprecated free-function wrappers. Prefer the Vec<T> methods. ---

// vec_push - append a value to a vector.
void vec_push<T>(mut &Vec<T> v, T val) {
    v.push(val);
}

// vec_get - read the element at `index` (unchecked).
T vec_get<T>(&Vec<T> v, i32 index) {
    return v.get(index);
}

// vec_len - number of elements in the vector.
u64 vec_len<T>(&Vec<T> v) {
    return v.len();
}

// vec_free - release the backing allocation.
void vec_free<T>(mut &Vec<T> v) {
    v.free();
}
