// std::vector
//
// Generic growable array backed by heap allocation.
//
// Usage:
//   load "std::vector";
//   using std::vector;
//
//   void main() {
//       @init mut Vec<i32> v;
//       vec_push<i32>(&v, 10);
//       vec_push<i32>(&v, 20);
//       vec_push<i32>(&v, 30);
//       std::io::print(vec_get<i32>(&v, 1) as str);  // 20
//       vec_free<i32>(&v);
//   }
//
// Notes:
//   - vec_free must be called to release memory.
//   - vec_get bounds are not checked.
//   - Generic calls require explicit type args (e.g. vec_push<i32>).

module "std::vector";

load "std::heap";

struct Vec<T> {
    mut *T data;
    mut i32 size;
    mut i32 capacity;
};

void vec_push<T>(mut &Vec<T> v, T val) {
    u64 elem_size = sizeof(T);
    if (v.capacity == 0) {
        v.data = std::heap::heap_malloc(elem_size) as! *T;
        v.capacity = 1;
    } else if (v.size >= v.capacity) {
        v.capacity *= 2;
        v.data = std::heap::heap_realloc(v.data as! *void, v.capacity * elem_size) as! *T;
    }
    v.data[v.size] = val;
    v.size++;
}

T vec_get<T>(&Vec<T> v, i32 index) {
    return v.data[index];
}

u64 vec_len<T>(&Vec<T> v) {
    return v.size as u64;
}

void vec_free<T>(mut &Vec<T> v) {
    if (v.capacity > 0) {
        std::heap::heap_free(v.data as! *void);
        v.data = 0 as! *T;
        v.capacity = 0;
    }
}
